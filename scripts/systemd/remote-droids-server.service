[Unit]
Description=Remote Droids Gesture Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/RemoteDroids
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/RemoteDroids/.venv/bin/python /home/pi/RemoteDroids/src/server/init.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
